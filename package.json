{
  "name": "dsh-plugin-jev-router",
  "version": "0.1.0",
  "description": "Per-turn model and reasoning-effort routing for DeepSeek Harness -- one Jev choice question per turn",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "import": "./lib/index.js", "types": "./lib/index.d.ts" } },
