  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": { "build": "tsc", "prepare": "tsc", "prepublishOnly": "tsc" },
  "keywords": ["dsh-plugin", "deepseek-harness", "jev", "router", "model-routing", "cost-optimization", "reasoning-effort"],
  "author": "YYTbit",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/YYTbit/dsh-plugin-jev-router" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "devDependencies": { "@types/node": "^26.2.0", "typescript": "^5.7.0" }
}
